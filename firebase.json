{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/**",
      "backup/**",
      "scripts/**",
      "riat-android/**",
      "**/*.apk",
      "**/*.aab",
      "**/*.jar",
      "**/*.gradle",
      "**/gradlew",
      "**/gradlew.bat"
    ],
    "rewrites": [
      {
        "source": "/ecosystem",
        "destination": "/ecosystem.html"
      },
      {
        "source": "/auth",
        "destination": "/auth.html"
      },
      {
        "source": "/hub",
        "destination": "/hub.html"
      },
      {
        "source": "/bank",
        "destination": "/apps/bank.html"
      },
      {
        "source": "/apps/bank",
        "destination": "/apps/bank.html"
      },
      {
        "source": "/messenger",
        "destination": "/apps/messenger.html"
      },
      {
        "source": "/apps/messenger",
        "destination": "/apps/messenger.html"
      },
      {
        "source": "/maps",
        "destination": "/apps/maps.html"
      },
      {
        "source": "/apps/maps",
        "destination": "/apps/maps.html"
      },
      {
        "source": "/database",
        "destination": "/apps/database.html"
      },
      {
        "source": "/apps/database",
        "destination": "/apps/database.html"
      },
      {
        "source": "/univerlife",
        "destination": "/apps/univerlife.html"
      },
      {
        "source": "/apps/univerlife",
        "destination": "/apps/univerlife.html"
      }
    ],
    "headers": [
      {
        "source": "update.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      }
    ],
    "site": "tsue-ecosystem"
  }
}